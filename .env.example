# ============================================
# Mini-RAG Configuration — DeepSeek V4 Flash
# ============================================

# DeepSeek API (필수)
# 발급: https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Server
PORT=4001

# Document paths
DOCS_PATH=./docs      # Auto-indexed on startup
DATA_PATH=./data      # SQLite DB + generated files

# Database
DB_PATH=./data/rag.sqlite

# Note: Vector embedding (all-MiniLM-L6-v2) runs locally.
# No OpenAI key needed.

# ============================================
# 레거시 (더 이상 사용하지 않음)
